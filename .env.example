# Rosetta Prompt configuration
# Copy this file to .env and fill in the values for the provider(s) you use.
# The app auto-creates a .env on first run; you only need keys for paid providers.
# Ollama needs NO API key and runs fully free/local.

# Which provider is active in the UI: OpenAI | OpenRouter | Ollama
ACTIVE_PROVIDER=Ollama

# --- OpenAI (paid) ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# --- OpenRouter (paid) ---
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
OPENROUTER_MODEL=mistralai/mixtral-8x7b-instruct

# --- Ollama (free / local) ---
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
